[Unit]
Description=Local OCI registry for the reservation application
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/library/registry:2
ContainerName=reservation-registry
PublishPort=192.168.122.10:5000:5000
Volume=reservation-registry-data.volume:/var/lib/registry

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
